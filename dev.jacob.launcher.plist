<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- make install puts this in ~/Library/LaunchAgents: starts Launcher at login, restarts it after a crash or kill. Cmd+Q (exit 0) stays quit. -->
<plist version="1.0"><dict>
	<key>Label</key><string>dev.jacob.launcher</string>
	<key>Program</key><string>/Applications/Launcher.app/Contents/MacOS/Launcher</string>
	<key>RunAtLoad</key><true/>
	<key>KeepAlive</key><dict><key>SuccessfulExit</key><false/></dict>
	<key>LimitLoadToSessionType</key><string>Aqua</string>
	<key>ProcessType</key><string>Interactive</string>
</dict></plist>
